# ===========================================
# HawkStars – Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (MongoDB) ---
DATABASE_URI=mongodb://localhost:27017/hawkstars

# --- PayloadCMS ---
PAYLOAD_SECRET=your-payload-secret-here

# --- Cloudinary (media storage) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EasyPay (payment processing) ---
EASYPAY_API_URL=https://api.test.easypay.pt/2.0
EASYPAY_API_KEY=
EASYPAY_ACCOUNT_ID=
# Shared secret that authenticates EasyPay webhook calls. Send it as an
# `x-webhook-token` HEADER on the notification EasyPay posts. A `?token=` query
# parameter is NOT accepted: nginx logs full request URLs to access.log verbatim,
# which would write the secret to disk on every callback.
# If this is unset the endpoint fails CLOSED — every notification is rejected
# with 401 and no donation is ever marked confirmed, so the public transparency
# total silently under-reports. Every rejection is reported to Sentry.
EASYPAY_WEBHOOK_SECRET=

# --- Google APIs (Drive, OAuth, email) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/refresh-token
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# NOTE: the crowdfunding supporters spreadsheet is NOT configured here. It is
# the "crowdfundingFileId" field on the Settings global in the admin panel
# (Drive share link: https://drive.google.com/file/d/THIS_PART_IS_THE_FILE_ID/view).
# Used by the "Import Crowdfunding Supporters from Drive" scheduled job
# (payload/jobs/tasks/importCrowdfundingSupporters.ts).

# LibreTranslate machine-translation. Powers the "Traduzir do PT" button on
# localized text fields in the admin. Defaults to a local instance on
# http://localhost:5000 if LIBRETRANSLATE_URL is unset. LIBRETRANSLATE_API_KEY
# is optional and only needed if your instance requires one.
LIBRETRANSLATE_URL=http://localhost:5000
# Sent as `api_key` on each request; omitted entirely when unset, because public
# instances reject an empty one.
LIBRETRANSLATE_API_KEY=

# Contact address sent in the User-Agent to Nominatim, whose usage policy
# requires one. Falls back to tech@hawkstars.org when unset.
GEOCODING_CONTACT_EMAIL=

# Gmail OAuth2 transactional email (nodemailer). Required in production.
# The refresh token must be minted from an OAuth client whose consent screen is
# in "Production" status (Testing-mode refresh tokens expire after 7 days).
GOOGLE_EMAIL_USER=
GOOGLE_NODEMAILER_CLIENT_ID=
GOOGLE_NODEMAILER_CLIENT_SECRET=
GOOGLE_NODEMAILER_REFRESH_TOKEN=

# sentry
SENTRY_AUTH_TOKEN=

# shadcn/ui
SHADCNBLOCKS_API_KEY=

# Set to "true" to seed dev users/content on boot. Never set in production.
SEED_DEV_DATA=false
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
