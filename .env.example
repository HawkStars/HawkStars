# ===========================================
# HawkStars – Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (MongoDB) ---
DATABASE_URI=mongodb://localhost:27017/hawkstars

# --- PayloadCMS ---
PAYLOAD_SECRET=your-payload-secret-here

# --- Cloudinary (media storage) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EasyPay (payment processing) ---
EASYPAY_API_URL=https://api.test.easypay.pt/2.0
EASYPAY_API_KEY=
EASYPAY_ACCOUNT_ID=
# Shared secret that authenticates EasyPay webhook calls. Append it to the
# notification URL configured in the EasyPay dashboard, e.g.
#   https://hawkstars.org/api/easypay?token=THE_SECRET
# (or send it as an `x-webhook-token` header). If unset, the webhook is still
# processed but flagged in Sentry as unauthenticated.
EASYPAY_WEBHOOK_SECRET=

# --- Google APIs (Drive, OAuth, email) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/refresh-token
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# LibreTranslate machine-translation. Powers the "Traduzir do PT" button on
# localized text fields in the admin. Defaults to a local instance on
# http://localhost:5000 if LIBRETRANSLATE_URL is unset. LIBRETRANSLATE_API_KEY
# is optional and only needed if your instance requires one.
LIBRETRANSLATE_URL=http://localhost:5000

# Gmail OAuth2 transactional email (nodemailer). Required in production.
# The refresh token must be minted from an OAuth client whose consent screen is
# in "Production" status (Testing-mode refresh tokens expire after 7 days).
GOOGLE_EMAIL_USER=
GOOGLE_NODEMAILER_CLIENT_ID=
GOOGLE_NODEMAILER_CLIENT_SECRET=
GOOGLE_NODEMAILER_REFRESH_TOKEN=
