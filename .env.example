# ===========================================
# HawkStars – Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (MongoDB) ---
DATABASE_URI=mongodb://localhost:27017/hawkstars

# --- PayloadCMS ---
PAYLOAD_SECRET=your-payload-secret-here

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EasyPay (payment processing) ---
EASYPAY_API_URL=https://api.test.easypay.pt/2.0
EASYPAY_API_KEY=
EASYPAY_ACCOUNT_ID=

# --- Google APIs (Drive, OAuth, email) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/refresh-token
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_EMAIL_USER=

# --- Instagram Graph API ---
# See app/api/instagram/route.ts for setup instructions.
# Token is auto-refreshed via Payload job; these are fallbacks.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
